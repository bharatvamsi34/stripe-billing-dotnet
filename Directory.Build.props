<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Tests and samples do not need XML docs; keep CA rules pragmatic. -->
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1062;CA2007;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1707;CA1515;CA1819;CA1056;CA1054;CA1031;CA1724;CA1032;CA1002;CA2227;CA1873</NoWarn>
  </PropertyGroup>
</Project>
